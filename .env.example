# Start safely on this computer only. For two-laptop LAN testing, change GATEWAY_HOST to 0.0.0.0
# and set FIREWALL_ALLOWED_SUBNETS to your actual private LAN subnet (example: 192.168.1.0/24).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=5000
FIREWALL_ALLOWED_SUBNETS=127.0.0.1/32,::1/128
FIREWALL_BLOCKED_IPS=
FIREWALL_RATE_LIMIT=30
FIREWALL_RATE_WINDOW=10
FIREWALL_BAN_DURATION=300
MAX_PAYLOAD_BYTES=65536
MAX_TIMESTAMP_AGE_SECONDS=300

# Generate unique random values; do not use these placeholder labels as actual secrets.
ADMIN_API_KEY=REPLACE_WITH_RANDOM_ADMIN_SECRET_AT_LEAST_24_CHARACTERS
FLASK_SECRET_KEY=REPLACE_WITH_RANDOM_FLASK_SECRET_AT_LEAST_32_CHARACTERS
# Example format; replace the placeholder with a unique random secret (16+ characters) before enabling the device.
DEVICE_SECRETS={"CS-ESP32-001":"REPLACE_WITH_RANDOM_DEVICE_SECRET_AT_LEAST_16_CHARS"}

# Leave blank to disable cross-origin browser requests. Add exact trusted origins only if needed.
TRUSTED_CORS_ORIGINS=
TRUSTED_PROXY_IPS=

# Optional cloud integration; blank means records are buffered locally.
CLOUD_ENDPOINT=
CLOUD_TIMEOUT_SECONDS=5
RETRY_INTERVAL_SECONDS=15
MAX_RETRY_ATTEMPTS=10
BACKUP_INTERVAL_SECONDS=86400
DB_PATH=data/gateway.db
LOG_PATH=logs/gateway.log
BACKUP_DIR=backups
ALERT_WEBHOOK_URL=
